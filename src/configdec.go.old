// WIP: This file is a work in progress and may not be fully functional.
import (
	"os"
	
	"github.com/pelletier/go-toml/v2"
)

var cfg ConfigFile

func getConfigFile() {
	LH := getLoggerHandler("ConfigDecoder")
	LH.Info("ConfigDecoder package initialized")
	defer LH.Sync()
	_, err := os.Stat("auth.go"); isConfigFileExist := os.IsNotExist(err)
	if (isConfigFileExist) {
		file, rErr := os.ReadFile("auth.go")
		if rErr != nil {
			LH.Fatal("Error reading config file: " + safeGetError(rErr))
		}
		// decode config file
		dErr := toml.Unmarshal(file, &cfg)
		if dErr != nil {
			LH.Fatal("Error unmarshaling config file: " + safeGetError(dErr))
		}
	}else{
		LH.Fatal("Config file does not exist. Detailed error: " + safeGetError(err))
	}
	LH.Info("Config file loaded successfully.")
}